# Copy to .env and fill in. Never commit .env.

# PostgreSQL started by `npm run db:up` (docker-compose.yml reads POSTGRES_* from this file).
# Choose your own user and password; the URLs below must use the same values.
POSTGRES_USER="<db-user>"
POSTGRES_PASSWORD="<db-password>"
POSTGRES_DB="rifada"
DATABASE_URL="postgresql://<db-user>:<db-password>@localhost:5433/rifada"
# The test database (created by docker/postgres-init) is used by `npm test`; it must differ from DATABASE_URL.
TEST_DATABASE_URL="postgresql://<db-user>:<db-password>@localhost:5433/rifada_test"

# Better Auth: generate a long random secret, e.g. `openssl rand -base64 48`
BETTER_AUTH_SECRET="<generate: openssl rand -base64 48>"
BETTER_AUTH_URL="http://localhost:3000"

# First super admin, created by `npm run db:seed`. Required; the seed refuses to run without them.
# The account must change this password on first login.
SEED_ADMIN_USERNAME="<admin-username>"
SEED_ADMIN_PASSWORD="<admin-password, 10+ characters>"
SEED_ADMIN_NAME="مدير النظام"

# Local file storage root for attachments (Phase 3)
STORAGE_DIR="./storage"

# Optional: password for the three development accounts created by `npm run db:seed:dev-users`.
# They are flagged as demo data and removed by the demo wipe. Never use in a real deployment.
DEV_USERS_PASSWORD="<dev-accounts-password>"
